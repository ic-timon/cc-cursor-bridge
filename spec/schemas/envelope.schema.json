{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ahp.invalid/schemas/1/envelope.schema.json",
  "title": "AHP v1 event envelope",
  "description": "Every pending/, push/ file and every events.jsonl line is one envelope.",
  "type": "object",
  "required": [
    "protocol",
    "task_id",
    "seq",
    "event",
    "class",
    "producer",
    "ts",
    "payload"
  ],
  "properties": {
    "protocol": {
      "$ref": "common.schema.json#/$defs/protocol"
    },
    "task_id": {
      "$ref": "common.schema.json#/$defs/task_id"
    },
    "seq": {
      "$ref": "common.schema.json#/$defs/seq"
    },
    "event": {
      "$ref": "common.schema.json#/$defs/event_name"
    },
    "class": {
      "$ref": "common.schema.json#/$defs/event_class"
    },
    "producer": {
      "$ref": "common.schema.json#/$defs/producer"
    },
    "ts": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "payload": {
      "type": "object"
    },
    "reply_file": {
      "$ref": "common.schema.json#/$defs/relpath"
    },
    "deadline": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "timeout_ms": {
      "type": "integer",
      "minimum": 0
    },
    "default_decision": {
      "$ref": "common.schema.json#/$defs/decision"
    },
    "decisions": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/decision"
      },
      "uniqueItems": true
    },
    "context": {
      "type": "object",
      "properties": {
        "session_id": {
          "type": "string"
        },
        "turn_id": {
          "type": "string"
        },
        "prompt_id": {
          "type": "string"
        },
        "cwd": {
          "type": "string"
        },
        "transcript_path": {
          "type": "string"
        },
        "permission_mode": {
          "type": "string"
        },
        "agent_id": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "native": {
      "type": "object",
      "description": "Host-specific trace data (e.g. CC hook name). Consumers MUST NOT depend on it for decisions.",
      "properties": {
        "event": {
          "type": "string"
        },
        "input_keys": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "truncated": {
      "type": "boolean"
    },
    "full_file": {
      "$ref": "common.schema.json#/$defs/relpath"
    },
    "outcome": {
      "type": "object",
      "description": "Only on events.jsonl records: what the producer finally did.",
      "required": [
        "via"
      ],
      "properties": {
        "decision": {
          "$ref": "common.schema.json#/$defs/decision"
        },
        "via": {
          "enum": [
            "reply",
            "timeout",
            "rule",
            "error",
            "invalid_reply",
            "cwd_read",
            "none"
          ]
        },
        "reason": {
          "type": "string"
        },
        "rule_id": {
          "type": "string"
        }
      },
      "additionalProperties": true
    }
  },
  "patternProperties": {
    "^x-": {}
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "event": {
            "const": "tool.pre"
          }
        },
        "required": [
          "event"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "events/tool.pre.schema.json"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event": {
            "const": "permission.request"
          }
        },
        "required": [
          "event"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "events/permission.request.schema.json"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event": {
            "const": "input.request"
          }
        },
        "required": [
          "event"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "events/input.request.schema.json"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event": {
            "const": "turn.stop"
          }
        },
        "required": [
          "event"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "events/turn.stop.schema.json"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event": {
            "const": "plan.update"
          }
        },
        "required": [
          "event"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "events/plan.update.schema.json"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event": {
            "const": "session.start"
          }
        },
        "required": [
          "event"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "events/session.start.schema.json"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event": {
            "const": "session.end"
          }
        },
        "required": [
          "event"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "events/session.end.schema.json"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event": {
            "const": "prompt.submit"
          }
        },
        "required": [
          "event"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "events/prompt.submit.schema.json"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event": {
            "const": "tool.post"
          }
        },
        "required": [
          "event"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "events/tool.post.schema.json"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event": {
            "const": "tool.error"
          }
        },
        "required": [
          "event"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "events/tool.error.schema.json"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event": {
            "const": "subagent.stop"
          }
        },
        "required": [
          "event"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "events/subagent.stop.schema.json"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event": {
            "const": "message.delta"
          }
        },
        "required": [
          "event"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "events/message.delta.schema.json"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event": {
            "const": "policy.deny"
          }
        },
        "required": [
          "event"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "events/policy.deny.schema.json"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event": {
            "const": "producer.error"
          }
        },
        "required": [
          "event"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "events/producer.error.schema.json"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event": {
            "const": "worktree.create"
          }
        },
        "required": [
          "event"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "events/worktree.create.schema.json"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "class": {
            "const": "gate"
          }
        },
        "required": [
          "class"
        ],
        "not": {
          "required": [
            "outcome"
          ]
        }
      },
      "then": {
        "required": [
          "reply_file",
          "deadline"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "truncated": {
            "const": true
          }
        },
        "required": [
          "truncated"
        ]
      },
      "then": {
        "required": [
          "full_file"
        ]
      }
    }
  ]
}
