{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ahp.invalid/schemas/1/ack.schema.json",
  "title": "AHP v1 ack (producer -> consumer), acks/<seq>.json",
  "type": "object",
  "required": [
    "protocol",
    "task_id",
    "seq",
    "status",
    "applied_decision",
    "ts"
  ],
  "properties": {
    "protocol": {
      "$ref": "common.schema.json#/$defs/protocol"
    },
    "task_id": {
      "$ref": "common.schema.json#/$defs/task_id"
    },
    "seq": {
      "$ref": "common.schema.json#/$defs/seq"
    },
    "status": {
      "enum": [
        "consumed",
        "expired",
        "invalid"
      ]
    },
    "applied_decision": {
      "$ref": "common.schema.json#/$defs/decision"
    },
    "via": {
      "enum": [
        "reply",
        "timeout",
        "rule",
        "error",
        "invalid_reply"
      ]
    },
    "reason": {
      "type": "string"
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "reply_sha256": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "accepted": {
      "type": "boolean",
      "description": "turn.stop only: false when the turn ended without an explicit ack."
    },
    "ts": {
      "$ref": "common.schema.json#/$defs/timestamp"
    }
  },
  "additionalProperties": false
}
