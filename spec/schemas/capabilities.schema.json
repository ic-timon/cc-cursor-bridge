{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ahp.invalid/schemas/1/capabilities.schema.json",
  "title": "AHP v1 capabilities.json (producer, written once at task start)",
  "type": "object",
  "required": [
    "protocol",
    "spec_version",
    "task_id",
    "producer",
    "created_at",
    "transport",
    "events",
    "features"
  ],
  "properties": {
    "protocol": {
      "$ref": "common.schema.json#/$defs/protocol"
    },
    "spec_version": {
      "type": "string",
      "pattern": "^1\\.\\d+\\.\\d+$"
    },
    "task_id": {
      "$ref": "common.schema.json#/$defs/task_id"
    },
    "producer": {
      "$ref": "common.schema.json#/$defs/producer"
    },
    "created_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "transport": {
      "enum": [
        "local-fs",
        "e2b-files"
      ]
    },
    "consumer_json": {
      "enum": [
        "absent",
        "applied",
        "partially_applied",
        "rejected"
      ]
    },
    "consumer_notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "events": {
      "type": "object",
      "propertyNames": {
        "$ref": "common.schema.json#/$defs/event_name"
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "class"
        ],
        "properties": {
          "class": {
            "$ref": "common.schema.json#/$defs/event_class"
          },
          "allowed_classes": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/$defs/event_class"
            }
          },
          "decisions": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/$defs/decision"
            }
          },
          "default_decision": {
            "$ref": "common.schema.json#/$defs/decision"
          },
          "timeout_ms": {
            "type": "integer",
            "minimum": 0
          },
          "reply_fields": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "native": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "class": {
                  "const": "gate"
                }
              }
            },
            "then": {
              "required": [
                "class",
                "decisions",
                "default_decision",
                "timeout_ms"
              ]
            }
          }
        ]
      }
    },
    "features": {
      "type": "object",
      "properties": {
        "acks": {
          "type": "boolean"
        },
        "full_files": {
          "type": "boolean"
        },
        "updated_input": {
          "type": "boolean"
        },
        "additional_context": {
          "type": "boolean"
        },
        "message_delta": {
          "type": "boolean"
        },
        "policy_deny_event": {
          "type": "boolean"
        },
        "consumer_rules": {
          "type": "boolean"
        }
      },
      "additionalProperties": {
        "type": "boolean"
      }
    },
    "limits": {
      "type": "object",
      "properties": {
        "max_field_chars": {
          "type": "integer",
          "minimum": 1
        },
        "content_chars": {
          "type": "integer",
          "minimum": 1
        },
        "command_chars": {
          "type": "integer",
          "minimum": 1
        },
        "max_blocks": {
          "type": "integer",
          "minimum": 0
        },
        "host_hook_timeout_ms": {
          "type": "integer",
          "minimum": 0
        },
        "max_gate_timeout_ms": {
          "type": "integer",
          "minimum": 1000
        },
        "max_additional_context_chars": {
          "type": "integer",
          "minimum": 1,
          "description": "Max length (Unicode code points) of one additional_context; longer replies are invalid, never truncated (spec 7.3). Default 10000."
        }
      },
      "additionalProperties": {
        "type": "integer"
      }
    },
    "rules": {
      "type": "object",
      "required": [
        "ids",
        "sha256"
      ],
      "properties": {
        "ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sha256": {
          "$ref": "common.schema.json#/$defs/sha256"
        },
        "source": {
          "type": "string"
        },
        "status": {
          "type": "object",
          "additionalProperties": {
            "enum": [
              "applied",
              "partially_applied",
              "unapplied"
            ]
          },
          "description": "Per rule id. A rule the producer cannot fully evaluate MUST NOT be reported as applied."
        },
        "required": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "redaction": {
      "type": "object",
      "properties": {
        "methods": {
          "type": "array",
          "items": {
            "enum": [
              "env-values",
              "patterns",
              "custom"
            ]
          }
        },
        "token": {
          "type": "string"
        }
      }
    }
  },
  "patternProperties": {
    "^x-": {}
  },
  "additionalProperties": false
}
