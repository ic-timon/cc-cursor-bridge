{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ahp.invalid/schemas/1/events/tool.error.schema.json",
  "title": "tool.error payload",
  "type": "object",
  "required": [
    "tool_name",
    "error"
  ],
  "properties": {
    "tool_name": {
      "type": "string",
      "minLength": 1
    },
    "tool_use_id": {
      "type": "string"
    },
    "tool_input": {
      "$ref": "../common.schema.json#/$defs/tool_input"
    },
    "mcp_server": {
      "type": [
        "string",
        "null"
      ]
    },
    "error": {
      "$ref": "../common.schema.json#/$defs/text"
    },
    "is_interrupt": {
      "type": "boolean"
    },
    "duration_ms": {
      "type": "integer",
      "minimum": 0
    }
  },
  "additionalProperties": true
}
