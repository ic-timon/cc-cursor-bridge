{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ahp.invalid/schemas/1/events/tool.pre.schema.json",
  "title": "tool.pre payload (gate)",
  "type": "object",
  "required": [
    "tool_name",
    "tool_input"
  ],
  "properties": {
    "tool_name": {
      "type": "string",
      "minLength": 1
    },
    "tool_use_id": {
      "type": "string"
    },
    "tool_input": {
      "$ref": "../common.schema.json#/$defs/tool_input"
    },
    "mcp_server": {
      "type": [
        "string",
        "null"
      ]
    },
    "tool_kind": {
      "enum": [
        "shell",
        "edit",
        "read",
        "search",
        "fetch",
        "ask",
        "other"
      ],
      "description": "Host-neutral tool category used by rules' tool_kinds (spec 4.3, 11)."
    },
    "command": {
      "$ref": "../common.schema.json#/$defs/text",
      "description": "shell kind only: POSIX-quoted join of argv, matched by command_regex."
    }
  },
  "additionalProperties": true,
  "description": "Before a tool runs. Decisions: allow | deny | ask."
}
