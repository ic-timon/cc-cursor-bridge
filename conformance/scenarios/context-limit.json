{
  "id": "context-limit",
  "title": "additional_context over limits.max_additional_context_chars is invalid, never truncated",
  "source": [
    "draft.3 (b)",
    "spec 7.2",
    "spec 7.3 #2"
  ],
  "producer": {
    "timeout_ms": 1500,
    "limits": {
      "max_additional_context_chars": 50
    }
  },
  "steps": [
    {
      "event": "session.start",
      "payload": {
        "source": "startup"
      }
    },
    {
      "event": "session.start",
      "payload": {
        "source": "resume"
      }
    },
    {
      "event": "tool.pre",
      "payload": {
        "tool_name": "Bash",
        "tool_use_id": "toolu_conf",
        "tool_input": {
          "command": "echo hi"
        }
      }
    },
    {
      "event": "tool.pre",
      "payload": {
        "tool_name": "Bash",
        "tool_use_id": "toolu_conf",
        "tool_input": {
          "command": "echo again"
        }
      }
    },
    {
      "event": "turn.stop",
      "payload": {
        "last_assistant_message": "done",
        "stop_active": false
      }
    }
  ],
  "consumer": [
    {
      "match": {
        "event": "session.start",
        "nth": 1
      },
      "action": "ack",
      "additional_context": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
    },
    {
      "match": {
        "event": "session.start",
        "nth": 2
      },
      "action": "ack",
      "additional_context": "yyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy"
    },
    {
      "match": {
        "event": "tool.pre",
        "nth": 1
      },
      "action": "allow",
      "additional_context": "zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz"
    },
    {
      "match": {
        "event": "tool.pre",
        "nth": 2
      },
      "action": "allow",
      "additional_context": "fits"
    },
    {
      "match": {
        "event": "turn.stop"
      },
      "action": "ack",
      "additional_context": "not allowed here"
    }
  ],
  "expect": [
    {
      "step": 0,
      "ack": "invalid",
      "injected": false
    },
    {
      "step": 1,
      "ack": "consumed",
      "injected": true
    },
    {
      "step": 2,
      "effect": "deny",
      "ack": "invalid",
      "injected": false
    },
    {
      "step": 3,
      "effect": "allow",
      "ack": "consumed",
      "injected": true
    },
    {
      "step": 4,
      "effect": "ack",
      "ack": "invalid",
      "accepted": false
    }
  ],
  "consumer_json": {
    "protocol": "ahp/1",
    "consumer": {
      "name": "conformance"
    },
    "event_classes": {
      "session.start": "gate"
    }
  },
  "expect_task": {
    "limits": {
      "max_additional_context_chars": 50
    },
    "capabilities_class": {
      "session.start": "gate"
    }
  }
}
