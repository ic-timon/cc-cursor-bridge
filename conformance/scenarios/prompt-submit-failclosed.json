{
  "id": "prompt-submit-failclosed",
  "title": "prompt.submit as a gate: timeout, invalid reply and crash block the turn",
  "source": [
    "draft.3 (c)",
    "spec 9.1"
  ],
  "producer": {
    "timeout_ms": 1500
  },
  "steps": [
    {
      "event": "prompt.submit",
      "payload": {
        "prompt": "hi"
      }
    },
    {
      "event": "prompt.submit",
      "payload": {
        "prompt": "again"
      }
    },
    {
      "event": "prompt.submit",
      "payload": {
        "prompt": "crash"
      },
      "fault": "crash"
    },
    {
      "event": "prompt.submit",
      "payload": {
        "prompt": "ok"
      }
    }
  ],
  "consumer": [
    {
      "match": {
        "event": "prompt.submit",
        "nth": 1
      },
      "action": "none"
    },
    {
      "match": {
        "event": "prompt.submit",
        "nth": 2
      },
      "action": "invalid"
    },
    {
      "match": {
        "event": "prompt.submit",
        "nth": 3
      },
      "action": "ack",
      "additional_context": "CTX"
    }
  ],
  "expect": [
    {
      "step": 0,
      "effect": "block",
      "via": "timeout",
      "ack": "expired",
      "injected": false
    },
    {
      "step": 1,
      "effect": "block",
      "via": "invalid_reply",
      "ack": "invalid",
      "injected": false
    },
    {
      "step": 2,
      "effect": "block",
      "via": "error",
      "ack": "expired",
      "injected": false
    },
    {
      "step": 3,
      "via": "reply",
      "ack": "consumed",
      "injected": true
    }
  ],
  "consumer_json": {
    "protocol": "ahp/1",
    "consumer": {
      "name": "conformance"
    },
    "event_classes": {
      "prompt.submit": "gate"
    }
  },
  "requires_gate": [
    "prompt.submit"
  ]
}
