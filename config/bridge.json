{
  "notifier": {
    "enabled": false,
    "events": [
      "PermissionRequest",
      "PreToolUse",
      "PostToolUseFailure",
      "StopFailure",
      "Stop",
      "Notification"
    ],
    "pre_tool_use": "denied_only",
    "endpoint": "https://api.cursor.com/v0/agents/{agent_id}/followup",
    "agent_id_env": "CC_BRIDGE_CURSOR_AGENT_ID",
    "api_key_env": "CC_BRIDGE_CURSOR_API_KEY"
  },
  "wait": {
    "enabled": false,
    "on_permission_request": true,
    "on_pre_tool_use": false,
    "timeout_seconds": 120,
    "poll_interval_seconds": 0.25,
    "timeout_decision": "deny"
  },
  "log": {
    "max_field_chars": 240
  },
  "assistant_text": {
    "enabled": false
  },
  "wait_all": {
    "enabled": false,
    "timeout_seconds": 120,
    "poll_interval_seconds": 0.25
  },
  "pending": {
    "command_chars": 4000,
    "content_chars": 2000
  },
  "stop": {
    "max_blocks": 3
  },
  "events": {
    "SessionStart": "push",
    "Setup": "log",
    "InstructionsLoaded": "log",
    "UserPromptSubmit": "push",
    "UserPromptExpansion": "push",
    "MessageDisplay": "log",
    "PreToolUse": "wait",
    "PermissionRequest": "wait",
    "PermissionDenied": "log",
    "PostToolUse": "push",
    "PostToolUseFailure": "push",
    "PostToolBatch": "log",
    "Notification": "log",
    "SubagentStart": "log",
    "SubagentStop": "push",
    "TaskCreated": "push",
    "TaskCompleted": "push",
    "Stop": "wait",
    "StopFailure": "push",
    "TeammateIdle": "push",
    "ConfigChange": "log",
    "CwdChanged": "log",
    "DirectoryAdded": "log",
    "FileChanged": "log",
    "WorktreeCreate": "push",
    "WorktreeRemove": "log",
    "PreCompact": "push",
    "PostCompact": "log",
    "PreModelSwitch": "push",
    "PostModelSwitch": "log",
    "Elicitation": "wait",
    "ElicitationResult": "log",
    "SessionEnd": "log"
  }
}
